}
/* Popup Style */
.popup-overlay {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 0.6);
	display: flex;
	justify-content: center;
	align-items: center;
	z-index: 9999;
	visibility: hidden;
	opacity: 0;
	transition: opacity 0.3s ease, visibility 0.3s ease;
}
.popup-overlay.show {
	visibility: visible;
	opacity: 1;
}
.popup-content {
	background: rgb(0,0,0,0.7);
	padding: 20px 40px 30px 40px;
	max-width: 660px;
	width: 100%;
	position: relative;
	box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	text-align: center;
}
.popup-content .title{
	color: white;
	font-family: Outfit;
	font-size: clamp(20px, 5vw, 30px);
	line-height: 40px;
	margin-bottom: 20px;
	font-weight:600;
}
.close-popup {
	position: absolute;
	top: -4px;
	right: 12px;
	font-size: 26px;
	font-weight: bold;
	color: white;
	cursor: pointer;
}
.popup-buttons{
	display: flex;
	gap: 12px;
	justify-content: center;
	align-items: center;
}
.popup-buttons button{
	background-color: #08803e;
	color: white;
	border: none;
	padding: 12px 24px;
	font-size: clamp(13px, 3vw, 16px);
	cursor: pointer;
	border-radius: 50px;
	width: 170px;
}
#sp-wp-carousel-free-id-2910.sp-wpcp-2910 .swiper-button-next i {
	color: #050505;
	padding: 7px 16px;
