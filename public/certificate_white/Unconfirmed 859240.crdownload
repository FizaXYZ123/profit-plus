<!-- start Simple Custom CSS and JS -->
<style>
body::-webkit-scrollbar {
	display: none !important;
}
body {
	-ms-overflow-style: none;
}
.site-content {
	transition: filter 0.3s ease-in-out;
}
/* Apply blur when menu is active */
.menu-active .site-content {
	filter: blur(5px);
}
.hfe-nav-menu__breakpoint-tablet .hfe-active-menu+.hfe-nav-menu__layout-horizontal {
	transition: all 0.8s ease-in-out;
	display: flex;
	align-items: flex-start;
	width: 100% !important;
	left: 0 !important;
}
.elementor-658 .elementor-element.elementor-element-336554f nav.hfe-dropdown{
	border-radius: 0 0 10px 10px;
}
.hfe-nav-menu__breakpoint-tablet .hfe-active-menu.hfe-active-menu-full-width+.hfe-nav-menu__layout-horizontal .hfe-nav-menu {
	box-shadow: 0px 3px 10px 2px lightgray;
	border-radius: 0 0 10px 10px;
	overflow: hidden;
}
.ast-container,
.ast-container-fluid {
	max-width: 1560px !important;
	padding: 0px;
}
.hfe-nav-menu-icon {
	padding: 0 24px !important;
}
.hfe-nav-menu__layout-horizontal .hfe-nav-menu {
	align-items: center;
}
.home-hero-section{
	background: linear-gradient(179deg, color(display-p3 0.014 0.0615 0.0356) 1.2%, color(display-p3 0.0562 0.2423 0.1405) 97.56%, color(display-p3 0.0974 0.5721 0.3126) 193.92%);
}
.ast-single-post .entry-content a{
	text-decoration: none;
}
.text-white-gradient>h1, .text-white-gradient>h2, .text-white-gradient>h3, .text-white-gradient>h4, .text-white-gradient>h5, .text-white-gradient>h6  {
	background: linear-gradient(90deg, color(display-p3 1 1 1) 0.16%, color(display-p3 0.6 0.6 0.6) 108.15%);
	background-clip: text;
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}
.text-grey-gradient>h1, .text-grey-gradient>h2, .text-grey-gradient>h3, .text-grey-gradient>h4, .text-grey-gradient>h5, .text-grey-gradient>h6{
	background: linear-gradient(90deg, color(display-p3 0 0 0) 0.08%, color(display-p3 0.4115 0.4115 0.4115) 100.38%);
	background-clip: text;
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}
.text-green-gradient>h1, .text-green-gradient>h2, .text-green-gradient>h3, .text-green-gradient>h4, .text-green-gradient>h5, .text-green-gradient>h6{
	background: linear-gradient(141deg, #005222 22.48%, #A5A5A5 79.42%);
	background-clip: text;
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}
.elementor-658 .elementor-element.elementor-element-2f21582{
	align-items: center;
}
.elementor-736{
	display: flex;
	justify-content: center;
}
.elementor-658 .elementor-element.elementor-element-f88a380, .elementor-736 .elementor-element.elementor-element-1a4f756.e-con{
	max-width: 1560px;
}
.background-video{
	backdrop-filter: blur(53px);
}
.svg-blur-1, .svg-blur-2, .svg-blur-3, .svg-blur-4, .background-blur {
	backdrop-filter: blur(17.5px) !important;
}
.svg-blur-1, .svg-blur-3 {
	animation: floatUpDown1 2.4s ease-in-out infinite;
}
@keyframes floatUpDown1 {
	0%, 100% {
		transform: translateY(0px);
	}
	50% {
		transform: translateY(-10px);
		/* move up */
	}
}
.svg-blur-2, .svg-blur-4 {
	animation: floatUpDown2 2.6s ease-in-out infinite;
}
@keyframes floatUpDown2 {
	0%, 100% {
		transform: translateY(0px);
	}
	60% {
		transform: translateY(-7px);
		/* move up */
	}
}
.background-blur{
	backdrop-filter: blur(17.5px);
	-webkit-backdrop-filter: blur(17.5px);
	/* for Safari */
	background-color: rgba(212, 212, 212, 0.1);
}
/* Clickable logo container styles */
html.pum-open.pum-open-overlay.pum-open-scrollable body>:not([aria-modal=true]){
	padding: 0 !important;
}
#ninja-logo-container, #kinetick-logo-container {
	cursor: pointer;
	transition: all 0.3s ease;
}
#ninja-content, #kinetick-content {
	display: none;
}
#ninja-logo-container.active-tab,
#kinetick-logo-container.active-tab {
	background-color: #e4f2f5;
}
#ninja-content.active-content,
#kinetick-content.active-content {
	display: flex;
}
.elementor-widget-n-accordion .e-n-accordion-item[open]>.e-n-accordion-item-title{
	border-radius: 20px 20px 0 0;
}
/* Footer */
.footer-blur{
	background: rgba(212, 212, 212, 0.10);
	background: color(display-p3 0.8314 0.8314 0.8314 / 0.10);
	backdrop-filter: blur(50px);
}
/* About-Company*/
.team-member{
	filter: grayscale(100%) contrast(1.1) brightness(1.1) sepia(1) hue-rotate(95deg) saturate(1.5);
}
.background-blur:hover .team-member{
	filter: none;
}
/* About-Software */
.about-sw-hero, .hero-section-gradient{
	background: linear-gradient(179deg, color(display-p3 0.014 0.0615 0.0356) 1.2%, color(display-p3 0.0562 0.2423 0.1405) 97.56%, color(display-p3 0.0974 0.5721 0.3126) 193.92%);
}
/* Success story */
.wpcf-fancybox-wrapper .fancybox-navigation .fancybox-button:hover{
	background-color: #08803E;
}
/* Blog-page */
.rt-tpg-container .grid-layout1 .rt-holder{
	padding: 24px;
	background-color: #A6DBBE;
	border-radius: 24px;
}
.rt-tpg-container .rt-holder .rt-detail{
	padding: 0;
}
.rt-tpg-container .rt-holder .tpg-el-image-wrap{
	border-radius: 16px;
	margin: 0px;
	height: 192px ;
}
.tpg-el-main-wrapper .tpg-el-image-wrap img{
	object-fit: unset
}
.rt-tpg-container .img_zoom_out .rt-holder .rt-img-holder img:not(.avatar), .rt-tpg-container .rt-holder:hover .rt-img-holder img:not(.avatar){
	transform: scale(1);
}
.rt-tpg-container .rt-holder .rt-detail .entry-title-wrapper .entry-title{
	color: #181818;
	font-family: Outfit;
	font-size: 28px;
	font-weight: 700;
	line-height: 36px;
	margin-top: 12px;
}
.rt-tpg-container .rt-holder .rt-detail .entry-title-wrapper .entry-title:hover{
	color: #055027;
}
.tpg-el-main-wrapper .post-meta-tags span{
	color: #181818;
	font-family: Manrope;
	font-size: 12px;
	font-weight: 400;
	line-height: 20px;
}
.tpg-el-main-wrapper .tpg-el-excerpt *{
