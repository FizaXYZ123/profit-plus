				0%, 100% {
					box-shadow: 0 0 0 0 rgba( 23, 184, 105, 0.7 );
				}
				50% {
					box-shadow: 0 0 0 6px rgba( 23, 184, 105, 0 );
				}
			}
			@media ( prefers-reduced-motion: reduce ) {
				#wpadminbar #wp-admin-bar-pum-notifications .pum-notifications-count {
					animation: none;
				}
			}
