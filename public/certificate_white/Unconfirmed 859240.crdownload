				height: 100%;
				background: #17b869;
				color: #fff;
				font-weight: 700;
				font-size: 12px;
				line-height: 1;
				cursor: pointer;
				transition: background 0.15s ease;
			}
			#adminmenu #menu-posts-popup .pum-notifications-marker:hover,
			#adminmenu #menu-posts-popup .pum-notifications-marker:focus {
				background: #13a05c;
